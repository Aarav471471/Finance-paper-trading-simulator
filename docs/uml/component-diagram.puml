@startuml component-diagram
!pragma layout smetana
title Paper Trading Simulator - Component Diagram
skinparam shadowing false

package "Presentation Layer (Swing + JavaFX 3D)" {
  [MainFrame] as MF
  [Pages: Login, Dashboard,\nMarket, Trade, Portfolio, History,\nAnalytics, Backtest, Auto-Trade, Leaderboard] as Pages
  [UI Components:\nStatCard, LineChart, CandleChart,\nOrderBook, Ticker] as Comp
  [3D Views (JavaFX):\nCoin3DView, Portfolio3DView] as ThreeD
}

package "Service Layer" {
  [AuthService] as Auth
  [TradingService] as Trading
  [MarketService] as Market
  [PortfolioService] as PortSvc
  [ChartService] as Charts
  [Analytics & Leaderboard] as Analytics
}

package "Trading Intelligence" {
  [Execution Model\n(spread + slippage)\n+ Order Book] as Exec
  [Strategies + BacktestEngine] as Backtest
  [PerformanceAnalyzer] as Perf
  [BotService] as Bots
}

package "Domain Model" {
  [Assets, Orders, User,\nAccount, Portfolio, Transaction] as Model
}

package "Infrastructure" {
  [LivePriceFeed\n(+ SimulatedPriceFeed fallback)] as Feed
  [Quote Providers:\nBinance, Finnhub, Yahoo] as Providers
  [Fee Calculators] as Fees
  [File Repositories] as Repo
  database "data/*.csv" as Files
}

MF --> Pages
Pages --> Comp
Pages --> ThreeD
Pages --> Auth
Pages --> Trading
Pages --> Market
Pages --> PortSvc

Auth --> Model
Trading --> Model
PortSvc --> Model
Market --> Model

Trading ..> Fees : <<FeeCalculator>>
Trading ..> Exec : <<ExecutionModel>>
Pages --> Charts
Pages --> Analytics
Pages --> Backtest
Pages --> Bots
Bots --> Trading
Bots --> Charts
Backtest --> Perf
Analytics --> Perf
Charts --> Providers : <<HistoryProvider>>
Feed ..> Charts : <<PriceListener>>
Trading ..> Repo : <<Repository>>
Auth ..> Repo : <<Repository>>
Repo --> Files : read / write CSV
Feed --> Providers : <<QuoteProvider>>
cloud "Market data APIs\n(HTTPS / JSON)" as Internet
Providers --> Internet : HTTPS
Feed ..> Market : <<PriceListener>>\nprice ticks
Feed ..> Trading : <<PriceListener>>\nprice ticks
@enduml
