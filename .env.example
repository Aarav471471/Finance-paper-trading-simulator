# Copy to ".env" and fill in, then run Docker with:
#   docker run --env-file .env -p 7860:7860 papertrader
# ".env" is git-ignored, so your keys are never committed.
# Every value is optional. Without them: Binance (crypto) + Yahoo Finance (stocks) still work.

# Groww Trade API: real NSE prices for Indian shares (read-only, no real orders)
GROWW_API_KEY=
GROWW_API_SECRET=
# or, instead of key + secret, a daily access token from the Groww Cloud page:
GROWW_ACCESS_TOKEN=

# Finnhub: real-time US stock quotes (free key from https://finnhub.io/register)
FINNHUB_API_KEY=

# live (default) or simulated
PAPERTRADER_DATA_MODE=live
